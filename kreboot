#! /bin/bash

if [ $(id -u) -ne 0 ]
then
   echo "$0 bust be run as root" 
   exit 1
fi

if [ -e "/etc/redhat-release" ]
then
    LASTKERNEL=$(rpm -q kernel --qf "%{INSTALLTIME} %{VERSION}-%{RELEASE}.%{ARCH}\n" | sort -nr | awk 'NR==1 {print $2}')
    kexec -l /boot/vmlinuz-$LASTKERNEL --initrd=/boot/initramfs-$LASTKERNEL.img --reuse-cmdline && systemctl kexec || echo "Erreur lors du chargement du kernel $LASTKERNEL"
fi

if [ -e "/etc/pve/local" ]
then
    LASTKERNEL=$(dpkg --list | grep proxmox-kernel | sort -n | awk 'NR==1 {print $3}')-pve
    kexec -l /boot/vmlinuz-$LASTKERNEL --initrd=/boot/initrd.img-$LASTKERNEL --reuse-cmdline && systemctl kexec || echo "Erreur lors du chargement du kernel $LASTKERNEL"
fi
